# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL (required for Google OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# xAI Voice Agent
XAI_API_KEY=
XAI_AGENT_ID=
XAI_SIP_URI=sip:+1XXXXXXXXXX@0.0.0.0:5060;transport=tls
XAI_SIP_WEBHOOK_SECRET=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# OpenAI Realtime (optional). Needed only if a line or outbound is switched to OpenAI in settings;
# until all three are set, calls stay on Grok.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_TEXT_MODEL=gpt-4.1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Voice Mode: "mock" | "live"
VOICE_MODE=mock

# Internal communication between web and voice-worker
VOICE_WORKER_INTERNAL_SECRET=

# Inbound agreements via Sign Flow (voice worker only; same value as SIGNFLOW_INTAKE_TOKEN on Sign Flow).
# The Sign Flow URL, phone numbers, and per-line settings live in Inbound -> Setup & Environment / Intake Lines.
SIGNFLOW_INTAKE_TOKEN=

# URLs
APP_BASE_URL=http://localhost:3000
VOICE_WORKER_BASE_URL=http://localhost:3001
